// Sunaidi WhatsApp platform — core data model.
//
// This platform REPLACES WATI's sending/inbox layer for VDMS (the visitor
// registration system). VDMS stays the system of record for events and
// visitors; its tables live in the `public` schema of the shared Supabase
// database. Everything this platform owns (phone numbers, conversations,
// messages, templates, campaigns) lives in a dedicated `whatsapp` schema in
// the SAME database, so we read VDMS data directly instead of duplicating it.
//
// VDMS `events` and `visitors` are exposed here as read-only Prisma `view`
// models; we never write to them. An "event" is still the top-level unit (each
// of the 5 WhatsApp numbers belongs to one VDMS event).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "views"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["whatsapp", "public"]
}

// ---------------------------------------------------------------------------
// VDMS (read-only views onto the public schema — owned by VDMS, never written)
// ---------------------------------------------------------------------------

enum ConsentStatus {
  OPTED_IN  @map("Opted-in")
  PENDING   @map("Pending")
  OPTED_OUT @map("Opted-out")

  @@map("consent_status")
  @@schema("public")
}

/// VDMS event (e.g. Saudi Franchise Expo, Jewellery Salon). Source of truth
/// lives in VDMS; we attach one WhatsApp number, templates and campaigns to it.
view VdmsEvent {
  id        String   @id @db.Uuid
  name      String
  createdAt DateTime @map("created_at")

  phoneNumber PhoneNumber?
  templates   MessageTemplate[]
  campaigns   Campaign[]
  visitors    VdmsVisitor[]

  @@map("events")
  @@schema("public")
}

/// VDMS visitor (registration record). We match inbound WhatsApp contacts to
/// these by phone to show the agent who they are and read their consent.
view VdmsVisitor {
  id        String        @id @db.Uuid
  name      String
  company   String
  phone     String
  email     String
  eventId   String?       @map("event_id") @db.Uuid
  consent   ConsentStatus
  country   String
  source    String
  createdAt DateTime      @map("created_at")

  event    VdmsEvent? @relation(fields: [eventId], references: [id])
  contacts Contact[]

  @@map("visitors")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Workspace, users, teams (whatsapp schema)
// ---------------------------------------------------------------------------

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  teams         Team[]
  phoneNumbers  PhoneNumber[]
  contacts      Contact[]
  conversations Conversation[]
  messages      Message[]
  templates     MessageTemplate[]
  campaigns     Campaign[]
  automations   Automation[]
  botFlows      BotFlow[]
  webhookEvents WebhookEvent[]

  @@schema("whatsapp")
}

enum Role {
  ADMIN
  SUPERVISOR
  AGENT

  @@schema("whatsapp")
}

model User {
  id          String   @id @default(cuid())
  workspaceId String
  // Matches the Supabase Auth user id.
  authUserId  String   @unique
  email       String
  name        String?
  role        Role     @default(AGENT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  teamMembers    TeamMember[]
  assignedConvos Conversation[] @relation("ConversationAssignee")
  sentMessages   Message[]      @relation("MessageSentByUser")

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@schema("whatsapp")
}

model Team {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  createdAt   DateTime @default(now())

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members       TeamMember[]
  conversations Conversation[] @relation("ConversationTeam")

  @@index([workspaceId])
  @@schema("whatsapp")
}

model TeamMember {
  teamId String
  userId String

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@schema("whatsapp")
}

// ---------------------------------------------------------------------------
// Phone numbers (each attached to one VDMS event)
// ---------------------------------------------------------------------------

enum QualityRating {
  GREEN
  YELLOW
  RED
  UNKNOWN

  @@schema("whatsapp")
}

model PhoneNumber {
  id             String        @id @default(cuid())
  workspaceId    String
  // VDMS event this number belongs to (public.events.id).
  eventId        String        @unique @db.Uuid
  // Meta WhatsApp Business Account id this number belongs to.
  wabaId         String
  // Meta phone number id used when calling the Graph API.
  phoneNumberId  String        @unique
  // Graph API bearer token for this number's WABA (secret — keep behind the
  // service role / RLS, never expose to the browser).
  accessToken    String
  // Graph API version to call, e.g. "v21.0".
  graphApiVersion String       @default("v21.0")
  displayPhone   String
  displayName    String?
  qualityRating  QualityRating @default(UNKNOWN)
  // Current per-portfolio messaging limit snapshot (e.g. 1000, 10000).
  messagingLimit Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  event         VdmsEvent      @relation(fields: [eventId], references: [id])
  conversations Conversation[]
  messages      Message[]
  campaigns     Campaign[]

  @@index([workspaceId])
  @@schema("whatsapp")
}

// ---------------------------------------------------------------------------
// Contacts
// ---------------------------------------------------------------------------

// A person is one contact across all events. When their phone matches a VDMS
// visitor we link it through visitorId; consent and profile then come from
// VDMS rather than being duplicated here.
model Contact {
  id          String   @id @default(cuid())
  workspaceId String
  // E.164 WhatsApp phone, e.g. 9665XXXXXXXX.
  waId        String
  name        String?
  // Linked VDMS visitor (public.visitors.id), set when we match by phone.
  visitorId   String?  @db.Uuid
  // Free-form key/value attributes set by automations.
  attributes  Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  visitor       VdmsVisitor?   @relation(fields: [visitorId], references: [id])
  tags          ContactTag[]
  conversations Conversation[]
  messages      Message[]

  @@unique([workspaceId, waId])
  @@index([workspaceId])
  @@index([visitorId])
  @@schema("whatsapp")
}

model Tag {
  id          String       @id @default(cuid())
  workspaceId String
  name        String
  contacts    ContactTag[]

  @@unique([workspaceId, name])
  @@schema("whatsapp")
}

model ContactTag {
  contactId String
  tagId     String

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@schema("whatsapp")
}

// ---------------------------------------------------------------------------
// Conversations and messages
// ---------------------------------------------------------------------------

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED

  @@schema("whatsapp")
}

model Conversation {
  id            String             @id @default(cuid())
  workspaceId   String
  contactId     String
  phoneNumberId String
  assigneeId    String?
  teamId        String?
  status        ConversationStatus @default(OPEN)
  // Last inbound message time; the 24h customer service window is measured from this.
  lastInboundAt DateTime?
  lastMessageAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact     Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  phoneNumber PhoneNumber @relation(fields: [phoneNumberId], references: [id])
  assignee    User?       @relation("ConversationAssignee", fields: [assigneeId], references: [id])
  team        Team?       @relation("ConversationTeam", fields: [teamId], references: [id])
  messages    Message[]
  notes       Note[]

  @@unique([contactId, phoneNumberId])
  @@index([workspaceId, status])
  @@index([assigneeId])
  @@schema("whatsapp")
}

enum MessageDirection {
  INBOUND
  OUTBOUND

  @@schema("whatsapp")
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED

  @@schema("whatsapp")
}

model Message {
  id             String           @id @default(cuid())
  workspaceId    String
  conversationId String
  contactId      String
  phoneNumberId  String
  direction      MessageDirection
  // whatsapp message type: text, image, document, template, interactive, etc.
  type           String
  // Full message payload as stored/sent.
  content        Json
  status         MessageStatus    @default(QUEUED)
  // Meta's wamid; unique so repeated webhooks are idempotent.
  waMessageId    String?          @unique
  errorCode      String?
  errorMessage   String?
  // Set for outbound messages sent by an agent (null for automated/broadcast).
  sentByUserId   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  phoneNumber  PhoneNumber  @relation(fields: [phoneNumberId], references: [id])
  sentByUser   User?        @relation("MessageSentByUser", fields: [sentByUserId], references: [id])

  @@index([conversationId, createdAt])
  @@index([workspaceId, createdAt])
  @@schema("whatsapp")
}

model Note {
  id             String   @id @default(cuid())
  conversationId String
  authorId       String?
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@schema("whatsapp")
}

// A reusable reply snippet agents can insert in the inbox composer.
model CannedReply {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  body        String
  // Optional "/shortcut" an agent can type to find it quickly.
  shortcut    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, title])
  @@index([workspaceId])
  @@schema("whatsapp")
}

// ---------------------------------------------------------------------------
// Templates and campaigns
// ---------------------------------------------------------------------------

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION

  @@schema("whatsapp")
}

enum TemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED

  @@schema("whatsapp")
}

model MessageTemplate {
  id          String           @id @default(cuid())
  workspaceId String
  // Optional owning VDMS event (public.events.id); null = shared across events.
  eventId     String?          @db.Uuid
  name        String
  language    String
  category    TemplateCategory
  // Header/body/footer/buttons structure as sent to Meta.
  components  Json
  status      TemplateStatus   @default(DRAFT)
  // Meta's template id once created.
  metaId      String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  event     VdmsEvent? @relation(fields: [eventId], references: [id])
  campaigns Campaign[]

  @@unique([workspaceId, name, language])
  @@index([workspaceId])
  @@schema("whatsapp")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
  CANCELLED

  @@schema("whatsapp")
}

model Campaign {
  id            String         @id @default(cuid())
  workspaceId   String
  // VDMS event (public.events.id) this campaign sends for.
  eventId       String         @db.Uuid
  phoneNumberId String
  // Optional link to a managed template record (template management lands
  // later); the approved template is identified by name + language for now.
  templateId       String?
  templateName     String
  templateLanguage String
  name          String
  status        CampaignStatus @default(DRAFT)
  scheduledAt   DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  event       VdmsEvent           @relation(fields: [eventId], references: [id])
  phoneNumber PhoneNumber         @relation(fields: [phoneNumberId], references: [id])
  template    MessageTemplate?    @relation(fields: [templateId], references: [id])
  recipients  CampaignRecipient[]

  @@index([workspaceId, status])
  @@schema("whatsapp")
}

model CampaignRecipient {
  id          String        @id @default(cuid())
  campaignId  String
  contactId   String
  // Per-recipient template variable values.
  variables   Json          @default("{}")
  status      MessageStatus @default(QUEUED)
  waMessageId String?
  errorCode   String?
  sentAt      DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@schema("whatsapp")
}

// ---------------------------------------------------------------------------
// Automations and chatbot flows
// ---------------------------------------------------------------------------

model Automation {
  id          String   @id @default(cuid())
  workspaceId String
  // Optional VDMS event scope (public.events.id).
  eventId     String?  @db.Uuid
  name        String
  enabled     Boolean  @default(true)
  // "welcome" | "out_of_office" | "keyword" | "assignment"
  trigger     String
  // Trigger conditions (e.g. keywords, working hours).
  conditions  Json     @default("{}")
  // Ordered actions (send template, assign, tag, ...).
  actions     Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@schema("whatsapp")
}

model BotFlow {
  id          String   @id @default(cuid())
  workspaceId String
  // Optional VDMS event scope (public.events.id).
  eventId     String?  @db.Uuid
  name        String
  enabled     Boolean  @default(false)
  // Node graph defining the conversation flow.
  graph       Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessions  BotSession[]

  @@index([workspaceId])
  @@schema("whatsapp")
}

model BotSession {
  id            String    @id @default(cuid())
  botFlowId     String
  contactId     String
  currentNodeId String?
  // Variables collected during the flow.
  variables     Json      @default("{}")
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  botFlow BotFlow @relation(fields: [botFlowId], references: [id], onDelete: Cascade)

  @@index([botFlowId])
  @@schema("whatsapp")
}

// ---------------------------------------------------------------------------
// Raw webhook log (for idempotency, replay and debugging)
// ---------------------------------------------------------------------------

model WebhookEvent {
  id          String    @id @default(cuid())
  workspaceId String?
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([receivedAt])
  @@schema("whatsapp")
}

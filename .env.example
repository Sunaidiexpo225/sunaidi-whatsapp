# ---- Database (Supabase Postgres) ----
# Pooled connection for the app (PgBouncer, port 6543)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
# Direct connection for Prisma migrations (port 5432)
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# ---- Supabase ----
SUPABASE_URL="https://[PROJECT].supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---- Redis (BullMQ) ----
REDIS_URL="redis://localhost:6379"

# ---- Meta WhatsApp Cloud API ----
# Graph API version, e.g. v23.0
WHATSAPP_GRAPH_API_VERSION="v23.0"
# System-user permanent access token (per business portfolio)
WHATSAPP_ACCESS_TOKEN=""
# Token Meta echoes back when verifying the webhook subscription
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# App secret, used to validate the X-Hub-Signature-256 header on webhooks
WHATSAPP_APP_SECRET=""

# ---- API ----
API_PORT="3001"
# Base URL the web app calls
NEXT_PUBLIC_API_URL="http://localhost:3001"
# Shared secret internal callers (VDMS) send on the x-api-key header to
# request template/badge sends. The web app also uses it server-side to
# proxy campaign/template/automation writes.
INTERNAL_API_KEY=""

# ---- Web (dashboard) ----
# Server-side base URL the web app uses to reach the API (defaults to
# NEXT_PUBLIC_API_URL). Set when the API is reachable at a different internal host.
API_BASE_URL=""
# Shared dashboard passcode. When empty, the login gate is disabled (local dev).
DASHBOARD_PASSWORD=""
# Optional explicit session-cookie value; derived from DASHBOARD_PASSWORD when unset.
SESSION_TOKEN=""
